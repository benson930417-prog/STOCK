[Unit]
Description=Stock ETF 09:30 Taiwan Fetch and Notify Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/STOCK
ExecStart=/usr/bin/bash /home/ubuntu/STOCK/scripts/update_and_notify.sh 00997A
StandardOutput=append:/home/ubuntu/STOCK/daily_fetch_0930_tw.log
StandardError=append:/home/ubuntu/STOCK/daily_fetch_0930_tw.log

[Install]
WantedBy=multi-user.target
