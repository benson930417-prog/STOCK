[Unit]
Description=STOCK Streamlit Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/STOCK
EnvironmentFile=-/home/ubuntu/.stock_secrets
ExecStart=/home/ubuntu/STOCK/venv/bin/streamlit run /home/ubuntu/STOCK/app.py --server.address 0.0.0.0 --server.port 8501
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/STOCK/stock_dashboard.log
StandardError=append:/home/ubuntu/STOCK/stock_dashboard.log

[Install]
WantedBy=multi-user.target
