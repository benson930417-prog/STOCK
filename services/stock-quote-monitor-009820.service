[Unit]
Description=009820 Holding Quote Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/STOCK
ExecStart=/home/ubuntu/STOCK/venv/bin/python /home/ubuntu/STOCK/scripts/monitor_etf_quotes.py 009820 --interval 180 --max-workers 4 --jitter 150
Restart=always
RestartSec=10
RuntimeMaxSec=12h
MemoryMax=512M
CPUQuota=35%
StandardOutput=append:/home/ubuntu/STOCK/quote_monitor_009820.log
StandardError=append:/home/ubuntu/STOCK/quote_monitor_009820.log

[Install]
WantedBy=multi-user.target
