[Unit]
Description=009820 Holding Quote Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/STOCK
EnvironmentFile=-/home/ubuntu/.stock_secrets
ExecStart=/home/ubuntu/STOCK/venv/bin/python /home/ubuntu/STOCK/scripts/monitor_etf_quotes.py 009820 --interval 60
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/STOCK/quote_monitor_009820.log
StandardError=append:/home/ubuntu/STOCK/quote_monitor_009820.log

[Install]
WantedBy=multi-user.target
