[Unit]
Description=Build STOCK derived analytics and notifications after canonical imports
After=stock-market-holdings.service
Wants=network-online.target
After=network-online.target

[Service]
Slice=stock-background.slice
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/STOCK
Environment=STOCK_GLOBAL_MARKET_DB=/var/lib/stock/market/market.db
ExecStart=/usr/bin/bash /home/ubuntu/STOCK/scripts/update_and_notify.sh --post-fetch 00403A 00981A 00988A 00991A 0050 0056 00830 00878 00891 00918 009805 009820
TimeoutStartSec=60min
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stock-derived-1920

[Install]
WantedBy=multi-user.target
