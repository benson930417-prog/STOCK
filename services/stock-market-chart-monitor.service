[Unit]
Description=TradingView Market Chart Cache Monitor
After=network-online.target stock-chart.service
Wants=network-online.target stock-chart.service

[Service]
Slice=stock-background.slice
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/STOCK
ExecStart=/home/ubuntu/STOCK/venv/bin/python /home/ubuntu/STOCK/scripts/monitor_market_charts.py oil brent bond gold usdtwd usdjpy usdchf nasdaq --interval 60
Restart=always
RestartSec=10
RuntimeMaxSec=12h
MemoryMax=512M
TasksMax=32
CPUQuota=35%
StandardOutput=append:/home/ubuntu/STOCK/market_chart_monitor.log
StandardError=append:/home/ubuntu/STOCK/market_chart_monitor.log

[Install]
WantedBy=multi-user.target
