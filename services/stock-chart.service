[Unit]
Description=Stock Dashboard Persistent Chart Service (Playwright)
After=network.target

[Service]
Slice=stock-background.slice
User=ubuntu
WorkingDirectory=/home/ubuntu/STOCK
ExecStart=/home/ubuntu/STOCK/venv/bin/python3 /home/ubuntu/STOCK/scripts/chart_service.py
Restart=always
RestartSec=5
RuntimeMaxSec=infinity
KillMode=mixed
TimeoutStopSec=210
MemoryHigh=2304M
MemoryMax=2560M
TasksMax=512
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
