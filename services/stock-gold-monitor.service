[Unit]
Description=TradingView GOLD Quote Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/STOCK
ExecStart=/home/ubuntu/STOCK/venv/bin/python /home/ubuntu/STOCK/scripts/monitor_gold_quote.py --interval 60
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/STOCK/gold_quote_monitor.log
StandardError=append:/home/ubuntu/STOCK/gold_quote_monitor.log

[Install]
WantedBy=multi-user.target
