[Unit]
Description=Stock ETF Daily Fetch and Notify Service
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/STOCK
# Using bash explicitly bypasses permission issues and ensures environment loading
ExecStart=/usr/bin/bash /home/ubuntu/STOCK/scripts/update_and_notify.sh
StandardOutput=append:/home/ubuntu/STOCK/daily_fetch.log
StandardError=append:/home/ubuntu/STOCK/daily_fetch.log

[Install]
WantedBy=multi-user.target
