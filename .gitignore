# Local design previews for the score chart (throwaway)
data/_preview_*

# A local ETF benchmark store is forbidden. Production uses only
# /var/lib/stock/market/market.db; ignore any accidental legacy leftovers so
# they cannot be committed while the runtime fail-closed checks reject them.
data/etf_bench/
data/score_history.csv

# Atomic-write leftovers from OneDrive/editor races
*.tmp.*

# Local research/backtest sandboxes do not belong in the production repo
strategy_experiment*/

