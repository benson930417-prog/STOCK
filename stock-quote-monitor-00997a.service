[Unit]
Description=00997A Holding Quote Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/STOCK
ExecStart=/home/ubuntu/STOCK/venv/bin/python /home/ubuntu/STOCK/scripts/monitor_etf_quotes.py 00997A --interval 60
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/STOCK/quote_monitor_00997a.log
StandardError=append:/home/ubuntu/STOCK/quote_monitor_00997a.log

[Install]
WantedBy=multi-user.target
